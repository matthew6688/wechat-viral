{
  "version": 2,
  "buildCommand": "cd backend && npm install && npm run build",
  "installCommand": "cd backend && npm install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "admin/**",
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
