{
  "version": 2,
  "buildCommand": "cd backend && npm install --include=dev && npm run build",
  "installCommand": "cd backend && npm install --include=dev",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "admin/**"
    }
  }
}
