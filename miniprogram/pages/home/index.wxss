/* pages/home/index.wxss - Apple 极简风格 */

.page {
  min-height: 100vh;
  background-color: var(--bg-secondary);
  padding-bottom: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
}

/* ========================================
   头部
   ======================================== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  padding-top: calc(var(--spacing-xl) + env(safe-area-inset-top));
  background-color: var(--bg-primary);
}

.user-section {
  display: flex;
  align-items: center;
}

.user-avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--gray-200);
  flex-shrink: 0;
}

.user-avatar {
  width: 100%;
  height: 100%;
}

.user-info {
  margin-left: var(--spacing-md);
}

.user-greeting {
  font-size: var(--font-size-subhead);
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.user-name {
  font-size: var(--font-size-title3);
  font-weight: 600;
  color: var(--text-primary);
  max-width: 280rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.points-display {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.points-value {
  font-size: var(--font-size-title2);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.points-label {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  margin-top: 2rpx;
}

/* ========================================
   快捷操作
   ======================================== */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: var(--spacing-lg) var(--spacing-md);
  background-color: var(--bg-primary);
  border-bottom: 1rpx solid var(--separator-color);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md);
}

.action-item:active {
  opacity: 0.6;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: var(--spacing-xs);
}

.action-text {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

/* ========================================
   区块
   ======================================== */
.section {
  margin-top: var(--spacing-xl);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-size-title3);
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: var(--font-size-subhead);
  color: var(--text-secondary);
}

/* ========================================
   卡片
   ======================================== */
.card {
  background-color: var(--bg-primary);
  border-radius: var(--radius-lg);
  margin: 0 var(--spacing-lg);
  overflow: hidden;
}

/* 进行中的活动卡片 */
.campaign-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  padding-bottom: var(--spacing-md);
}

.campaign-info {
  flex: 1;
}

.campaign-name {
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.campaign-progress {
  display: flex;
  align-items: center;
}

.progress-text {
  font-size: var(--font-size-footnote);
  color: var(--text-secondary);
}

.campaign-arrow {
  font-size: var(--font-size-title3);
  color: var(--gray-300);
  margin-left: var(--spacing-md);
}

.progress-bar {
  height: 4rpx;
  background-color: var(--gray-200);
  margin: 0 var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: var(--primary);
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
}

/* 活动列表 */
.campaign-list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  position: relative;
}

.campaign-list-item::after {
  content: '';
  position: absolute;
  left: var(--spacing-lg);
  right: 0;
  bottom: 0;
  height: 1rpx;
  background-color: var(--separator-color);
}

.campaign-list-item:last-child::after {
  display: none;
}

.campaign-list-item:active {
  background-color: var(--gray-100);
}

.campaign-list-info {
  flex: 1;
  min-width: 0;
}

.campaign-list-name {
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.campaign-list-desc {
  font-size: var(--font-size-footnote);
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.campaign-list-arrow {
  font-size: var(--font-size-title3);
  color: var(--gray-300);
  margin-left: var(--spacing-md);
}

/* ========================================
   动态列表
   ======================================== */
.activity-list {
  padding: 0;
}

.activity-item {
  display: flex;
  align-items: flex-start;
  padding: var(--spacing-md) var(--spacing-lg);
  position: relative;
}

.activity-item::after {
  content: '';
  position: absolute;
  left: 80rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background-color: var(--separator-color);
}

.activity-item:last-child::after {
  display: none;
}

.activity-icon {
  font-size: 32rpx;
  margin-right: var(--spacing-md);
  margin-top: 4rpx;
}

.activity-content {
  flex: 1;
  min-width: 0;
}

.activity-text {
  font-size: var(--font-size-subhead);
  color: var(--text-primary);
  line-height: 1.5;
}

.activity-time {
  font-size: var(--font-size-caption);
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

/* ========================================
   空状态
   ======================================== */
.empty-card {
  padding: var(--spacing-2xl) var(--spacing-lg);
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.4;
}

.empty-text {
  font-size: var(--font-size-subhead);
  color: var(--text-secondary);
}

/* ========================================
   底部安全区
   ======================================== */
.bottom-safe {
  height: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
}
