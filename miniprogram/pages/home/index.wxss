.home-container {
  padding: 32rpx 32rpx 180rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* User Header */
.user-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-container {
  position: relative;
}

.avatar-badge {
  width: 88rpx;
  height: 88rpx;
  background-color: #fef3c7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.user-details {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.user-phone {
  font-size: 24rpx;
  color: #6b7280;
}

.points-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #1a1a2e;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.points-icon {
  font-size: 16rpx;
  color: #10b981;
}

.points-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid #e5e7eb;
}

.action-icon {
  font-size: 28rpx;
}

.action-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a2e;
}

/* Section */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #6b7280;
  letter-spacing: 0.1em;
  margin-bottom: 20rpx;
  display: block;
  padding-left: 8rpx;
}

/* Tasks */
.tasks-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  border: 2rpx solid #e5e7eb;
}

.task-left {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  flex: 1;
}

.task-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.task-checkbox.checked {
  background-color: #10b981;
  border-color: #10b981;
}

.check-icon {
  font-size: 20rpx;
  color: #ffffff;
}

.task-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.task-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.task-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
}

.task-action {
  font-size: 24rpx;
  font-weight: 500;
  color: #1a1a2e;
  margin-top: 8rpx;
}

.task-points {
  font-size: 26rpx;
  font-weight: 500;
  color: #6b7280;
}

/* Activity */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.activity-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 8rpx;
}

.activity-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #10b981;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.activity-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.activity-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
}

.activity-date {
  font-size: 24rpx;
  color: #9ca3af;
}

.activity-points {
  font-size: 26rpx;
  font-weight: 500;
}

.activity-points.positive {
  color: #10b981;
}

.activity-points.negative {
  color: #ef4444;
}

/* Empty State */
.empty-state {
  padding: 40rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}
