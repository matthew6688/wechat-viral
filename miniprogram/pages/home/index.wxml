<!--pages/home/index.wxml - Apple 极简风格-->
<view class="page">
  <!-- 顶部用户区域 -->
  <view class="header">
    <view class="user-section">
      <view class="user-avatar-wrap" bindtap="authorizeProfile">
        <image 
          class="user-avatar" 
          src="{{user.wechat_avatar_url || user.avatar_url || '/images/default-avatar.png'}}" 
          mode="aspectFill"
        />
      </view>
      <view class="user-info">
        <view class="user-greeting">Hi,</view>
        <view class="user-name">{{user.wechat_nickname || user.nickname || user.name || '用户'}}</view>
      </view>
    </view>
    
    <view class="points-display" bindtap="goToRewards">
      <view class="points-value">{{user.total_points || 0}}</view>
      <view class="points-label">积分</view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="goToCampaigns">
      <view class="action-icon">🎯</view>
      <view class="action-text">参与活动</view>
    </view>
    <view class="action-item" bindtap="goToInvite">
      <view class="action-icon">🔗</view>
      <view class="action-text">邀请好友</view>
    </view>
    <view class="action-item" bindtap="goToRewards">
      <view class="action-icon">🎁</view>
      <view class="action-text">我的奖品</view>
    </view>
    <view class="action-item" bindtap="goToProfile">
      <view class="action-icon">⚙️</view>
      <view class="action-text">设置</view>
    </view>
  </view>

  <!-- 进行中的活动 -->
  <view class="section" wx:if="{{currentCampaign}}">
    <view class="section-header">
      <text class="section-title">进行中的活动</text>
    </view>
    <view class="card" bindtap="goToCurrentCampaign">
      <view class="campaign-card">
        <view class="campaign-info">
          <view class="campaign-name">{{currentCampaign.name}}</view>
          <view class="campaign-progress">
            <view class="progress-text">{{currentCampaign.helper_count || 0}}/{{currentCampaign.required_helpers || 8}} 人</view>
          </view>
        </view>
        <view class="campaign-arrow">›</view>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{currentCampaignProgress}}%"></view>
      </view>
    </view>
  </view>

  <!-- 可参与的活动 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">可参与的活动</text>
      <text class="section-more" bindtap="goToCampaigns">全部</text>
    </view>
    
    <view class="card" wx:if="{{campaigns && campaigns.length > 0}}">
      <view 
        class="campaign-list-item" 
        wx:for="{{campaigns}}" 
        wx:key="id"
        bindtap="goToCampaign"
        data-id="{{item.id}}"
      >
        <view class="campaign-list-info">
          <view class="campaign-list-name">{{item.name}}</view>
          <view class="campaign-list-desc">{{item.description || '参与活动赢取丰厚奖品'}}</view>
        </view>
        <view class="campaign-list-arrow">›</view>
      </view>
    </view>
    
    <view class="card empty-card" wx:else>
      <view class="empty-content">
        <view class="empty-icon">📋</view>
        <view class="empty-text">暂无可参与的活动</view>
      </view>
    </view>
  </view>

  <!-- 最近动态 -->
  <view class="section" wx:if="{{recentActivities && recentActivities.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近动态</text>
    </view>
    <view class="card">
      <view class="activity-list">
        <view class="activity-item" wx:for="{{recentActivities}}" wx:key="id">
          <view class="activity-icon">{{item.icon || '📌'}}</view>
          <view class="activity-content">
            <view class="activity-text">{{item.description}}</view>
            <view class="activity-time">{{item.time_ago || item.created_at}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="bottom-safe"></view>
</view>
