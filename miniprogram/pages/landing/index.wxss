.landing-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #ffffff;
  padding: 48rpx 40rpx;
  padding-bottom: 80rpx;
}

.logo-section {
  margin-bottom: 48rpx;
}

.logo-icon {
  width: 72rpx;
  height: 72rpx;
  background-color: #1a1a2e;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text {
  font-size: 32rpx;
  color: #ffffff;
}

.hero-section {
  margin-bottom: 40rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.hero-subtitle {
  font-size: 30rpx;
  color: #6b7280;
  display: block;
  line-height: 1.6;
  font-weight: 400;
}

.hero-image-container {
  margin-bottom: 40rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.hero-image {
  width: 100%;
  height: 400rpx;
  display: block;
}

.description-section {
  margin-bottom: 48rpx;
}

.description-text {
  font-size: 28rpx;
  color: #6b7280;
  line-height: 1.7;
  font-weight: 400;
}

.cta-section {
  margin-top: auto;
}

.btn-cta {
  width: 100%;
  background-color: #1a1a2e;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
}

.btn-cta::after {
  border: none;
}

.btn-arrow {
  font-size: 32rpx;
}
