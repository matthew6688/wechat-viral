.landing-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #ffffff;
  color: #000000;
}

.landing-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 120rpx 40rpx 80rpx;
}

.hero-content {
  width: 100%;
  max-width: 750rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}

.headline {
  font-size: 40px;
  font-weight: 500;
  color: #000000;
  margin-bottom: 24rpx;
  line-height: 1.2;
  letter-spacing: -0.03em;
}

.subheadline {
  font-size: 15px;
  color: #737373;
  margin-bottom: 80rpx;
  line-height: 1.6;
  font-weight: 400;
}

.body-card {
  background-color: transparent;
  padding: 0;
  border-radius: 0;
  width: 100%;
  border: none;
  border-top: 1rpx solid #e5e5e5;
  padding-top: 60rpx;
  margin-bottom: 80rpx;
}

.body-content {
  font-size: 15px;
  color: #737373;
  line-height: 1.6;
  font-weight: 400;
}

.cta-section {
  padding: 0 40rpx 80rpx;
  width: 100%;
}

.btn-primary {
  width: 100%;
  background-color: #000000;
  color: #ffffff;
  border-radius: 0;
  padding: 20rpx 0;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: -0.01em;
}
