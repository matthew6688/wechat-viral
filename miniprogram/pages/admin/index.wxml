<view class="admin-container">
  <!-- Header -->
  <view class="header">
    <view class="header-icon">⚙</view>
    <text class="header-title">Admin Console</text>
  </view>

  <!-- Tabs -->
  <view class="tabs">
    <view 
      class="tab {{currentTab === 'users' ? 'active' : ''}}"
      data-tab="users"
      bindtap="switchTab"
    >
      Users
    </view>
    <view 
      class="tab {{currentTab === 'offers' ? 'active' : ''}}"
      data-tab="offers"
      bindtap="switchTab"
    >
      Offers
    </view>
    <view 
      class="tab {{currentTab === 'tasks' ? 'active' : ''}}"
      data-tab="tasks"
      bindtap="switchTab"
    >
      Tasks
    </view>
  </view>

  <!-- Users Tab -->
  <view wx:if="{{currentTab === 'users'}}" class="tab-content">
    <view class="table">
      <view class="table-header">
        <text class="th name">Name</text>
        <text class="th points">Points</text>
      </view>
      <view class="table-body">
        <view wx:for="{{users || []}}" wx:key="id" class="table-row">
          <view class="td name">
            <text class="user-name">{{item.name}}</text>
            <text class="user-phone">{{item.phone}}</text>
          </view>
          <text class="td points">{{item.points || 0}}</text>
        </view>
        <view wx:if="{{!users || users.length === 0}}" class="empty-row">
          <text>No users found</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Offers Tab -->
  <view wx:if="{{currentTab === 'offers'}}" class="tab-content">
    <view class="table">
      <view class="table-header">
        <text class="th name">Reward</text>
        <text class="th points">Points</text>
      </view>
      <view class="table-body">
        <view wx:for="{{rewards || []}}" wx:key="id" class="table-row">
          <view class="td name">
            <text class="user-name">{{item.name}}</text>
            <text class="user-phone">{{item.description}}</text>
          </view>
          <text class="td points">{{item.points_required}}</text>
        </view>
        <view wx:if="{{!rewards || rewards.length === 0}}" class="empty-row">
          <text>No rewards found</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Tasks Tab -->
  <view wx:if="{{currentTab === 'tasks'}}" class="tab-content">
    <view class="table">
      <view class="table-header">
        <text class="th name">Task</text>
        <text class="th points">Points</text>
      </view>
      <view class="table-body">
        <view wx:for="{{tasks || []}}" wx:key="id" class="table-row">
          <view class="td name">
            <text class="user-name">{{item.name}}</text>
            <text class="user-phone">{{item.description}}</text>
          </view>
          <text class="td points">{{item.points}}</text>
        </view>
        <view wx:if="{{!tasks || tasks.length === 0}}" class="empty-row">
          <text>No tasks found</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Stats Summary -->
  <view class="stats-section">
    <view class="stat-card">
      <text class="stat-value">{{stats.totalUsers || 0}}</text>
      <text class="stat-label">Total Users</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.totalInvites || 0}}</text>
      <text class="stat-label">Invites</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.conversionRate || 0}}%</text>
      <text class="stat-label">Conversion</text>
    </view>
  </view>
</view>
