.container {
  background-color: #ffffff;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header {
  padding: 60rpx 40rpx 40rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.title {
  font-size: 16px;
  font-weight: 500;
  color: #000000;
  letter-spacing: -0.02em;
}

.tabs {
  display: flex;
  border-bottom: 1rpx solid #e5e5e5;
  padding: 0 40rpx;
  margin-top: 40rpx;
}

.tab-item {
  flex: 1;
  text-align: left;
  padding: 20rpx 0;
  font-size: 13px;
  color: #737373;
  border-bottom: 1rpx solid transparent;
  font-weight: 400;
  letter-spacing: -0.01em;
}

.tab-item.active {
  color: #000000;
  border-bottom-color: #000000;
  font-weight: 500;
}

.tab-content {
  padding: 80rpx 40rpx;
}

.section {
  margin-bottom: 80rpx;
}

.section-title {
  font-size: 13px;
  font-weight: 500;
  color: #737373;
  margin-bottom: 32rpx;
  display: block;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.event-item {
  background-color: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  border-bottom: 1rpx solid #e5e5e5;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
}

.event-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.event-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 12rpx;
}

.event-type,
.event-status {
  font-size: 14px;
  font-weight: 500;
  color: #000000;
  letter-spacing: -0.01em;
}

.event-scene {
  font-size: 12px;
  color: #737373;
  font-family: monospace;
  font-weight: 400;
}

.event-time {
  font-size: 12px;
  color: #a3a3a3;
  font-weight: 400;
}

.event-user {
  padding-top: 8rpx;
  border-top: none;
  font-size: 12px;
  color: #737373;
  font-weight: 400;
}

.input-group {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.input {
  flex: 1;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.picker-input {
  flex: 1;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background-color: white;
}

.btn-primary {
  background-color: #111827;
  color: white;
  border-radius: 8rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  border: none;
}

.referral-chain {
  background-color: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx;
}

.chain-item {
  margin-bottom: 16rpx;
}

.chain-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-right: 16rpx;
}

.chain-invitee {
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #374151;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.chain-time {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rpx;
  border-top: 1rpx solid #e5e5e5;
  border-left: 1rpx solid #e5e5e5;
  margin-bottom: 80rpx;
}

.stat-item {
  background-color: #ffffff;
  border: none;
  border-radius: 0;
  padding: 40rpx 24rpx;
  text-align: left;
  border-right: 1rpx solid #e5e5e5;
  border-bottom: 1rpx solid #e5e5e5;
}

.stat-value {
  font-size: 32px;
  font-weight: 500;
  color: #000000;
  display: block;
  margin-bottom: 4rpx;
  letter-spacing: -0.03em;
}

.stat-label {
  font-size: 12px;
  color: #737373;
  display: block;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 400;
}

.settings-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}

.info-text {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  padding: 24rpx;
}

.empty-state {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}
