.admin-container {
  padding: 32rpx 32rpx 180rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  margin-bottom: 32rpx;
}

.header-icon {
  font-size: 36rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* Tabs */
.tabs {
  display: flex;
  gap: 32rpx;
  margin-bottom: 32rpx;
  border-bottom: 2rpx solid #e5e7eb;
  padding-bottom: 0;
}

.tab {
  font-size: 28rpx;
  font-weight: 500;
  color: #6b7280;
  padding-bottom: 16rpx;
  border-bottom: 3rpx solid transparent;
  margin-bottom: -2rpx;
}

.tab.active {
  color: #1a1a2e;
  border-bottom-color: #1a1a2e;
}

/* Tab Content */
.tab-content {
  margin-bottom: 32rpx;
}

/* Table */
.table {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #e5e7eb;
}

.table-header {
  display: flex;
  padding: 20rpx 24rpx;
  background-color: #f9fafb;
  border-bottom: 2rpx solid #e5e7eb;
}

.th {
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
}

.th.name {
  flex: 1;
}

.th.points {
  width: 120rpx;
  text-align: right;
}

.table-body {
  max-height: 600rpx;
  overflow-y: auto;
}

.table-row {
  display: flex;
  padding: 24rpx;
  border-bottom: 2rpx solid #f3f4f6;
  align-items: center;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  font-size: 28rpx;
}

.td.name {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.td.points {
  width: 120rpx;
  text-align: right;
  color: #1a1a2e;
  font-weight: 500;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
}

.user-phone {
  font-size: 24rpx;
  color: #9ca3af;
}

.empty-row {
  padding: 48rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

/* Stats Section */
.stats-section {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.stat-card {
  flex: 1;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  border: 2rpx solid #e5e7eb;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #9ca3af;
}
