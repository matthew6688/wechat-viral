<view class="rewards-container">
  <!-- Header -->
  <view class="header">
    <text class="title">Rewards</text>
    <view class="points-badge">
      <text class="points-icon">●</text>
      <text class="points-value">{{points}} PTS</text>
    </view>
  </view>

  <!-- Available Rewards -->
  <view class="section">
    <text class="section-title">AVAILABLE</text>
    <view class="rewards-list">
      <view wx:for="{{rewards || []}}" wx:key="id" class="reward-card">
        <!-- Reward Image -->
        <view class="reward-image-container">
          <image 
            class="reward-image" 
            src="{{item.image_url || 'https://images.unsplash.com/photo-1519681393784-d120267933ba?w=600&q=80'}}" 
            mode="aspectFill" 
          />
          <view class="reward-points-badge">
            <text>{{item.points_required}} PTS</text>
          </view>
        </view>
        
        <!-- Reward Info -->
        <view class="reward-info">
          <text class="reward-name">{{item.name}}</text>
          <text class="reward-desc">{{item.description}}</text>
          <text wx:if="{{points < item.points_required}}" class="reward-need">Need {{item.points_required - points}} more PTS</text>
          
          <!-- Action Buttons -->
          <view class="reward-actions">
            <view class="btn-details">Details</view>
            <view class="btn-earn" data-id="{{item.id}}" bindtap="redeemReward">{{points >= item.points_required ? 'Redeem' : 'Earn'}}</view>
          </view>
        </view>
      </view>
      
      <view wx:if="{{!rewards || rewards.length === 0}}" class="empty-state">
        <text>No rewards available</text>
      </view>
    </view>
  </view>

  <!-- Redemption History -->
  <view class="section" wx:if="{{redemptions && redemptions.length > 0}}">
    <text class="section-title">REDEEMED</text>
    <view class="redemptions-list">
      <view wx:for="{{redemptions || []}}" wx:key="id" class="redemption-item">
        <view class="redemption-content">
          <text class="redemption-name">{{item.reward_name}}</text>
          <text class="redemption-date">{{item.created_at}}</text>
        </view>
        <text class="redemption-check">✓</text>
      </view>
    </view>
  </view>
</view>
