.rewards-container {
  padding: 32rpx 32rpx 180rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding: 16rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.points-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #1a1a2e;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.points-icon {
  font-size: 16rpx;
  color: #10b981;
}

.points-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

/* Section */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #10b981;
  letter-spacing: 0.1em;
  margin-bottom: 20rpx;
  display: block;
  padding-left: 8rpx;
}

/* Rewards List */
.rewards-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.reward-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.reward-image-container {
  position: relative;
  width: 100%;
  height: 300rpx;
}

.reward-image {
  width: 100%;
  height: 100%;
}

.reward-points-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background-color: #ffffff;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a2e;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.reward-info {
  padding: 28rpx;
}

.reward-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 8rpx;
}

.reward-desc {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.reward-need {
  font-size: 24rpx;
  color: #ef4444;
  display: block;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.reward-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-details {
  flex: 1;
  padding: 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a2e;
}

.btn-earn {
  flex: 1;
  padding: 20rpx;
  border: 2rpx solid #10b981;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #10b981;
}


/* Redemptions */
.redemptions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.redemption-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.redemption-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.redemption-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
}

.redemption-date {
  font-size: 24rpx;
  color: #9ca3af;
}

.redemption-check {
  font-size: 28rpx;
  color: #10b981;
}

/* Empty State */
.empty-state {
  padding: 60rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}
