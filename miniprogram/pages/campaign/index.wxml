<!--pages/campaign/index.wxml - Apple 极简风格-->
<view class="page">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中</text>
  </view>

  <!-- 主内容 -->
  <view class="content" wx:else>
    <!-- 活动头部 -->
    <view class="header">
      <view class="header-top">
        <view class="badge-status {{campaign.status === 'active' ? 'badge-active' : 'badge-ended'}}">
          {{campaign.status === 'active' ? '进行中' : '已结束'}}
        </view>
        <view class="header-actions">
          <view class="action-btn" bindtap="refreshPage">
            <text class="icon">↻</text>
          </view>
        </view>
      </view>
      
      <view class="campaign-title">{{campaign.name || '活动名称'}}</view>
      <view class="campaign-subtitle" wx:if="{{campaign.description}}">{{campaign.description}}</view>
    </view>

    <!-- 进度卡片 -->
    <view class="card progress-card">
      <view class="progress-header">
        <view class="progress-label">助力进度</view>
        <view class="progress-count">
          <text class="count-current">{{participation.helper_count || 0}}</text>
          <text class="count-divider">/</text>
          <text class="count-total">{{maxHelpers || 8}}</text>
        </view>
      </view>
      
      <view class="progress-bar-container">
        <view class="progress-bar-bg"></view>
        <view class="progress-bar-fill" style="width: {{progressPercent}}%"></view>
      </view>
      
      <view class="progress-footer">
        <view class="progress-info">
          <text class="info-text" wx:if="{{remainingHelpers > 0}}">还需 {{remainingHelpers}} 人即可完成</text>
          <text class="info-text success" wx:else>🎉 恭喜，任务已完成！</text>
        </view>
      </view>
    </view>

    <!-- 奖品列表 -->
    <view class="section">
      <view class="section-header">奖品</view>
      <view class="card-inset">
        <view class="reward-list">
          <view 
            class="reward-item {{index <= currentRewardIndex ? 'reward-unlocked' : 'reward-locked'}}"
            wx:for="{{rewards}}" 
            wx:key="id"
            bindtap="onRewardClick"
            data-reward="{{item}}"
            data-index="{{index}}"
          >
            <view class="reward-icon-wrap">
              <image 
                class="reward-icon" 
                src="{{item.reward_image_url || 'https://images.unsplash.com/photo-1513475382585-d06e58bcb0e0?w=200&q=80'}}" 
                mode="aspectFill"
              />
              <view class="reward-check" wx:if="{{index < currentRewardIndex}}">✓</view>
            </view>
            <view class="reward-info">
              <view class="reward-name">{{item.reward_name || item.name}}</view>
              <view class="reward-requirement">需 {{item.required_helpers || item.helpers_required}} 人助力</view>
            </view>
            <view class="reward-status">
              <view class="status-badge unlocked" wx:if="{{(participation.helper_count || 0) >= (item.required_helpers || item.helpers_required || 0)}}">已解锁</view>
              <view class="status-badge current" wx:elif="{{index === currentRewardIndex && (participation.helper_count || 0) < (item.required_helpers || item.helpers_required || 0)}}">进行中</view>
              <view class="status-badge locked" wx:else>未解锁</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 分享海报 -->
    <view class="section">
      <view class="section-header">邀请好友</view>
      <view class="card-inset">
        <view class="share-card">
          <view class="poster-preview" wx:if="{{posterUrl}}">
            <image class="poster-image" src="{{posterUrl}}" mode="aspectFit" />
          </view>
          <view class="poster-placeholder" wx:else>
            <view class="placeholder-icon">🖼</view>
            <view class="placeholder-text">点击生成专属海报</view>
          </view>
          
          <view class="share-actions">
            <button class="share-btn primary" bindtap="generatePoster" wx:if="{{!posterUrl}}">
              生成海报
            </button>
            <button class="share-btn primary" bindtap="savePoster" wx:else>
              保存到相册
            </button>
            <button class="share-btn secondary" open-type="share">
              分享给好友
            </button>
          </view>
        </view>
      </view>
    </view>

    <!-- 助力好友 -->
    <view class="section" wx:if="{{helpers && helpers.length > 0}}">
      <view class="section-header">
        <text>助力好友</text>
        <text class="section-count">{{helpers.length}}</text>
      </view>
      <view class="card-inset">
        <view class="helper-list">
          <view class="helper-item" wx:for="{{helpers}}" wx:key="id">
            <image 
              class="helper-avatar" 
              src="{{item.wechat_avatar_url || item.helper_avatar || 'https://ui-avatars.com/api/?name=User&background=cccccc&color=fff&size=200'}}" 
              mode="aspectFill"
            />
            <view class="helper-info">
              <view class="helper-name">{{item.wechat_nickname || item.helper_name || '微信用户'}}</view>
              <view class="helper-time">{{item.created_at_formatted || item.help_time}}</view>
            </view>
            <view class="helper-status valid" wx:if="{{item.is_valid !== false}}">有效</view>
            <view class="helper-status invalid" wx:else>无效</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="section" wx:if="{{!helpers || helpers.length === 0}}">
      <view class="section-header">助力好友</view>
      <view class="card-inset">
        <view class="empty-state">
          <view class="empty-icon">👥</view>
          <view class="empty-title">暂无助力</view>
          <view class="empty-text">分享海报邀请好友来助力吧</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 关注公众号提示 -->
  <view class="modal-overlay" wx:if="{{showOAFollowModal}}" bindtap="closeOAFollowModal">
    <view class="modal-sheet" catchtap>
      <view class="modal-handle"></view>
      <view class="modal-content">
        <view class="modal-header">
          <view class="modal-title">关注公众号</view>
        </view>
        <view class="modal-body">
          <view class="qrcode-wrap">
            <image 
              class="qrcode-image" 
              src="{{oaFollowQRCode}}" 
              mode="aspectFit"
              show-menu-by-longpress="{{true}}"
            />
          </view>
          <view class="qrcode-tips">
            <view class="tip-item">1. 长按识别二维码关注公众号</view>
            <view class="tip-item">2. 关注后即可接收助力通知</view>
          </view>
        </view>
        <view class="modal-footer">
          <button class="modal-btn" bindtap="closeOAFollowModal">我已关注</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 授权提示 -->
  <view class="modal-overlay" wx:if="{{showAuthModal}}" bindtap="closeAuthModal">
    <view class="modal-center" catchtap>
      <view class="modal-content">
        <view class="modal-header center">
          <view class="modal-title">授权提示</view>
        </view>
        <view class="modal-body center">
          <view class="auth-icon">👤</view>
          <view class="auth-text">为了更好的体验，请允许获取您的微信头像和昵称</view>
        </view>
        <view class="modal-footer">
          <button class="modal-btn secondary" bindtap="closeAuthModal">取消</button>
          <button class="modal-btn primary" bindtap="authorizeProfile">允许</button>
        </view>
      </view>
    </view>
  </view>
</view>
