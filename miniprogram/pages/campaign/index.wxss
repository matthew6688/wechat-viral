/* pages/campaign/index.wxss - Apple 极简风格 */

.page {
  min-height: 100vh;
  background-color: var(--bg-secondary);
}

/* ========================================
   加载状态
   ======================================== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: var(--bg-secondary);
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid var(--gray-200);
  border-top-color: var(--gray-500);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-subhead);
  color: var(--text-secondary);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========================================
   头部
   ======================================== */
.header {
  padding: var(--spacing-lg);
  padding-top: calc(var(--spacing-xl) + env(safe-area-inset-top));
  background-color: var(--bg-primary);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.badge-status {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  font-weight: 500;
}

.badge-active {
  background-color: rgba(52, 199, 89, 0.12);
  color: var(--green);
}

.badge-ended {
  background-color: var(--gray-200);
  color: var(--text-secondary);
}

.header-actions {
  display: flex;
  gap: var(--spacing-sm);
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--gray-100);
  border-radius: 50%;
}

.action-btn .icon {
  font-size: 36rpx;
  color: var(--text-secondary);
}

.campaign-title {
  font-size: var(--font-size-large-title);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.campaign-subtitle {
  margin-top: var(--spacing-sm);
  font-size: var(--font-size-body);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ========================================
   进度卡片
   ======================================== */
.content {
  padding-bottom: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
}

.progress-card {
  margin: var(--spacing-lg);
  padding: var(--spacing-lg);
  background-color: var(--bg-primary);
  border-radius: var(--radius-lg);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: var(--spacing-md);
}

.progress-label {
  font-size: var(--font-size-subhead);
  color: var(--text-secondary);
}

.progress-count {
  display: flex;
  align-items: baseline;
}

.count-current {
  font-size: var(--font-size-title1);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.count-divider {
  font-size: var(--font-size-title3);
  color: var(--gray-300);
  margin: 0 8rpx;
}

.count-total {
  font-size: var(--font-size-title3);
  color: var(--text-secondary);
}

.progress-bar-container {
  position: relative;
  height: 8rpx;
  margin-bottom: var(--spacing-md);
}

.progress-bar-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background-color: var(--gray-200);
  border-radius: var(--radius-full);
}

.progress-bar-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background-color: var(--primary);
  border-radius: var(--radius-full);
  transition: width 0.5s ease;
}

.progress-footer {
  display: flex;
  justify-content: flex-start;
}

.info-text {
  font-size: var(--font-size-footnote);
  color: var(--text-secondary);
}

.info-text.success {
  color: var(--green);
}

/* ========================================
   区块
   ======================================== */
.section {
  margin-top: var(--spacing-xl);
}

.section-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  font-size: var(--font-size-title3);
  font-weight: 600;
  color: var(--text-primary);
  padding: 0 var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.section-count {
  font-size: var(--font-size-subhead);
  font-weight: 500;
  color: var(--text-secondary);
}

.card-inset {
  background-color: var(--bg-primary);
  border-radius: var(--radius-lg);
  margin: 0 var(--spacing-lg);
  overflow: hidden;
}

/* ========================================
   奖品列表
   ======================================== */
.reward-list {
  padding: 0;
}

.reward-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-lg);
  position: relative;
}

.reward-item::after {
  content: '';
  position: absolute;
  left: 128rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background-color: var(--separator-color);
}

.reward-item:last-child::after {
  display: none;
}

.reward-locked {
  opacity: 0.5;
}

.reward-icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-right: var(--spacing-lg);
  flex-shrink: 0;
}

.reward-icon {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md);
  background-color: var(--gray-100);
}

.reward-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: var(--green);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.reward-info {
  flex: 1;
  min-width: 0;
}

.reward-name {
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.reward-requirement {
  font-size: var(--font-size-footnote);
  color: var(--text-secondary);
}

.reward-status {
  margin-left: var(--spacing-md);
}

.status-badge {
  font-size: var(--font-size-caption);
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

.status-badge.unlocked {
  background-color: rgba(52, 199, 89, 0.12);
  color: var(--green);
}

.status-badge.current {
  background-color: rgba(0, 122, 255, 0.12);
  color: var(--blue);
}

.status-badge.locked {
  background-color: var(--gray-200);
  color: var(--text-tertiary);
}

/* ========================================
   分享海报
   ======================================== */
.share-card {
  padding: var(--spacing-lg);
}

.poster-preview {
  width: 100%;
  aspect-ratio: 9/16;
  background-color: var(--gray-100);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: var(--spacing-lg);
}

.poster-image {
  width: 100%;
  height: 100%;
}

.poster-placeholder {
  width: 100%;
  aspect-ratio: 4/3;
  background-color: var(--gray-100);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.placeholder-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.4;
}

.placeholder-text {
  font-size: var(--font-size-subhead);
  color: var(--text-tertiary);
}

.share-actions {
  display: flex;
  gap: var(--spacing-md);
}

.share-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  font-weight: 500;
  border: none;
}

.share-btn::after {
  border: none;
}

.share-btn.primary {
  background-color: var(--primary);
  color: #FFFFFF;
}

.share-btn.secondary {
  background-color: var(--gray-200);
  color: var(--text-primary);
}

.share-btn:active {
  opacity: 0.7;
}

/* ========================================
   助力好友列表
   ======================================== */
.helper-list {
  padding: 0;
}

.helper-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  position: relative;
}

.helper-item::after {
  content: '';
  position: absolute;
  left: 104rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background-color: var(--separator-color);
}

.helper-item:last-child::after {
  display: none;
}

.helper-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--gray-200);
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.helper-info {
  flex: 1;
  min-width: 0;
}

.helper-name {
  font-size: var(--font-size-body);
  font-weight: 500;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.helper-time {
  font-size: var(--font-size-caption);
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.helper-status {
  font-size: var(--font-size-caption);
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.helper-status.valid {
  color: var(--green);
  background-color: rgba(52, 199, 89, 0.1);
}

.helper-status.invalid {
  color: var(--red);
  background-color: rgba(255, 59, 48, 0.1);
}

/* ========================================
   空状态
   ======================================== */
.empty-state {
  padding: var(--spacing-2xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.4;
}

.empty-title {
  font-size: var(--font-size-headline);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.empty-text {
  font-size: var(--font-size-subhead);
  color: var(--text-secondary);
}

/* ========================================
   模态框
   ======================================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.modal-sheet {
  width: 100%;
  background-color: var(--bg-primary);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  animation: slideUp 0.3s ease-out;
}

.modal-center {
  width: 560rpx;
  background-color: var(--bg-primary);
  border-radius: var(--radius-xl);
  margin-bottom: auto;
  margin-top: auto;
  animation: fadeIn 0.25s ease-out;
}

.modal-handle {
  width: 72rpx;
  height: 8rpx;
  background-color: var(--gray-300);
  border-radius: var(--radius-full);
  margin: var(--spacing-md) auto;
}

.modal-content {
  overflow: hidden;
}

.modal-header {
  padding: var(--spacing-md) var(--spacing-lg);
}

.modal-header.center {
  text-align: center;
}

.modal-title {
  font-size: var(--font-size-headline);
  font-weight: 600;
  color: var(--text-primary);
}

.modal-body {
  padding: var(--spacing-lg);
}

.modal-body.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* 二维码 */
.qrcode-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.qrcode-image {
  width: 360rpx;
  height: 360rpx;
  border-radius: var(--radius-md);
}

.qrcode-tips {
  padding: var(--spacing-md);
  background-color: var(--gray-100);
  border-radius: var(--radius-md);
}

.tip-item {
  font-size: var(--font-size-footnote);
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 授权 */
.auth-icon {
  font-size: 100rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.4;
}

.auth-text {
  font-size: var(--font-size-body);
  color: var(--text-secondary);
  line-height: 1.6;
  padding: 0 var(--spacing-md);
}

.modal-footer {
  display: flex;
  padding: var(--spacing-md) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom));
  gap: var(--spacing-md);
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  font-weight: 500;
  border: none;
  background-color: var(--primary);
  color: #FFFFFF;
}

.modal-btn::after {
  border: none;
}

.modal-btn.secondary {
  background-color: var(--gray-200);
  color: var(--text-primary);
}

.modal-btn.primary {
  background-color: var(--primary);
  color: #FFFFFF;
}

.modal-btn:active {
  opacity: 0.7;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}
