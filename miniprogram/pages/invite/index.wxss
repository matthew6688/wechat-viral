.invite-container {
  padding: 32rpx 32rpx 180rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* Header */
.header {
  text-align: center;
  margin-bottom: 32rpx;
  padding: 16rpx 0;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* Poster Section */
.poster-section {
  margin-bottom: 32rpx;
}

.poster-container {
  position: relative;
  background-color: #ffffff;
  border-radius: 24rpx;
  border: 2rpx solid #e5e7eb;
  overflow: hidden;
  min-height: 600rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 600rpx;
}

.placeholder-text {
  font-size: 24rpx;
  color: #9ca3af;
  letter-spacing: 0.1em;
}

.poster-image {
  width: 100%;
  max-height: 800rpx;
}

.qr-preview {
  width: 400rpx;
  height: 400rpx;
}

.nav-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #9ca3af;
}

.nav-prev {
  left: 16rpx;
}

.nav-next {
  right: 16rpx;
}

/* Action Buttons */
.actions-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.btn-save {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  background-color: #1a1a2e;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-save::after {
  border: none;
}

.btn-copy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  background-color: #ffffff;
  color: #1a1a2e;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-copy::after {
  border: none;
}

.btn-icon {
  font-size: 28rpx;
}

/* Reward Info */
.reward-info {
  background-color: #ffffff;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
}

.reward-label {
  font-size: 20rpx;
  color: #9ca3af;
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 8rpx;
}

.reward-text {
  font-size: 28rpx;
  color: #1a1a2e;
}

.reward-highlight {
  color: #10b981;
  font-weight: 600;
}

/* Code Section */
.code-section {
  margin-top: 24rpx;
  text-align: center;
  padding: 16rpx;
}

.code-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.code-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  font-family: 'SF Mono', monospace;
}
