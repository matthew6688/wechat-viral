<view class="invite-container">
  <!-- Header -->
  <view class="header">
    <text class="title">Share & Earn</text>
  </view>

  <!-- Poster Preview -->
  <view class="poster-section">
    <view class="poster-container">
      <view wx:if="{{!posterImage && !mpQRCode}}" class="poster-placeholder">
        <text class="placeholder-text">RENDERING...</text>
      </view>
      <image wx:if="{{posterImage}}" class="poster-image" src="{{posterImage}}" mode="aspectFit" />
      <image wx:elif="{{mpQRCode}}" class="qr-preview" src="{{mpQRCode}}" mode="aspectFit" />
      
      <!-- Navigation Arrows -->
      <view class="nav-arrow nav-prev" bindtap="prevSlide">‹</view>
      <view class="nav-arrow nav-next" bindtap="nextSlide">›</view>
    </view>
  </view>

  <!-- Action Buttons -->
  <view class="actions-section">
    <button class="btn-save" bindtap="savePoster">
      <text class="btn-icon">⬇</text>
      <text>Save Image</text>
    </button>
    
    <button class="btn-copy" bindtap="copyReferralLink">
      <text class="btn-icon">🔗</text>
      <text>Copy Link</text>
    </button>
  </view>

  <!-- Reward Info -->
  <view class="reward-info">
    <text class="reward-label">REWARD</text>
    <view class="reward-text">
      <text>Get </text>
      <text class="reward-highlight">+50 Points</text>
      <text> per signup</text>
    </view>
  </view>

  <!-- Referral Code (Hidden but accessible) -->
  <view class="code-section" wx:if="{{referralCode}}">
    <text class="code-label">Your Code: </text>
    <text class="code-value">{{referralCode}}</text>
  </view>
</view>
