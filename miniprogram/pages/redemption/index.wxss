.container {
  padding: 40rpx;
  background-color: #ffffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 48rpx;
  border: 1rpx solid #e5e7eb;
  width: 100%;
}

.success-icon {
  width: 160rpx;
  height: 160rpx;
  background-color: #f3f4f6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  color: #111827;
  margin: 80rpx auto 32rpx;
}

.success-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #111827;
  margin-bottom: 16rpx;
  display: block;
}

.success-desc {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 64rpx;
  display: block;
}

.reward-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #111827;
  margin-bottom: 32rpx;
  display: block;
}

.delivery-section {
  margin-top: 32rpx;
}

.delivery-label {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
  margin-bottom: 24rpx;
  display: block;
}

.url-display, .code-display, .text-display {
  background-color: #f9fafb;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
  border: 1rpx solid #e5e7eb;
  font-size: 24rpx;
  color: #374151;
  word-break: break-all;
}

.code-display {
  font-size: 48rpx;
  font-weight: bold;
  font-family: monospace;
  letter-spacing: 4rpx;
}

.btn-primary {
  width: 100%;
  background-color: #111827;
  color: white;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 40rpx;
}
