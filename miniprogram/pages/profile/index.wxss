.profile-container {
  padding: 32rpx 32rpx 180rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* User Header */
.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.avatar-container {
  position: relative;
}

.avatar-badge {
  width: 100rpx;
  height: 100rpx;
  background-color: #fef3c7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.user-phone {
  font-size: 26rpx;
  color: #6b7280;
}

/* Info Cards */
.info-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.info-card {
  flex: 1;
  padding: 28rpx;
  border-radius: 16rpx;
}

.info-card.light {
  background-color: #f3f4f6;
}

.info-card.dark {
  background-color: #1a1a2e;
}

.card-label {
  font-size: 20rpx;
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 8rpx;
}

.info-card.light .card-label {
  color: #6b7280;
}

.info-card.dark .card-label {
  color: #9ca3af;
}

.card-value {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}

.info-card.light .card-value {
  color: #1a1a2e;
}

.info-card.dark .card-value {
  color: #ffffff;
}

/* Section */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #9ca3af;
  letter-spacing: 0.1em;
  margin-bottom: 20rpx;
  display: block;
  padding-left: 8rpx;
}

/* Details List */
.details-list {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid #e5e7eb;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-icon {
  width: 48rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.detail-label {
  font-size: 28rpx;
  color: #6b7280;
  flex: 1;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
}

/* Actions */
.actions {
  margin-top: 48rpx;
}

.btn-signout {
  width: 100%;
  background-color: transparent;
  color: #ef4444;
  border: 2rpx solid #fecaca;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-signout::after {
  border: none;
}

.btn-admin {
  width: 100%;
  background-color: #1a1a2e;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 16rpx;
  border: none;
}

.btn-admin::after {
  border: none;
}
