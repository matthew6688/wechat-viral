.container {
  padding-bottom: 120rpx;
  background-color: #ffffff;
}

.profile-header {
  background-color: #ffffff;
  color: #000000;
  padding: 80rpx 40rpx 60rpx;
  text-align: left;
  border-bottom: 1rpx solid #e5e5e5;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background-color: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 500;
  color: #000000;
  margin-bottom: 24rpx;
  border: 1rpx solid #e5e5e5;
}

.avatar-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
  border: 1rpx solid #e5e5e5;
}

.user-name {
  font-size: 24px;
  font-weight: 500;
  color: #000000;
  margin-bottom: 8rpx;
  display: block;
  letter-spacing: -0.02em;
}

.user-company {
  font-size: 13px;
  color: #737373;
  display: block;
  font-weight: 400;
}

.card {
  background-color: transparent;
  border-radius: 0;
  padding: 60rpx 40rpx;
  margin: 0;
  border: none;
  position: relative;
  z-index: 1;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rpx;
  margin-bottom: 60rpx;
  border-top: 1rpx solid #e5e5e5;
  border-left: 1rpx solid #e5e5e5;
}

.info-item {
  background-color: #ffffff;
  padding: 32rpx 24rpx;
  border-radius: 0;
  border: none;
  border-right: 1rpx solid #e5e5e5;
  border-bottom: 1rpx solid #e5e5e5;
}

.info-label {
  font-size: 12px;
  font-weight: 400;
  color: #737373;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 8rpx;
  display: block;
}

.info-value {
  font-size: 15px;
  font-weight: 500;
  color: #000000;
  letter-spacing: -0.01em;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.info-icon {
  font-size: 32rpx;
  width: 60rpx;
  height: 60rpx;
  background-color: transparent;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.btn-admin {
  width: 100%;
  background-color: transparent;
  color: #000000;
  border-radius: 0;
  padding: 20rpx 0;
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 16rpx;
  border: 1rpx solid #e5e5e5;
  letter-spacing: -0.01em;
}

.btn-logout {
  width: 100%;
  background-color: transparent;
  color: #737373;
  border: 1rpx solid #e5e5e5;
  border-radius: 0;
  padding: 20rpx 0;
  font-size: 14px;
  font-weight: 400;
  letter-spacing: -0.01em;
}

.debug-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #e5e7eb;
}

.debug-id {
  font-family: monospace;
  font-size: 12px;
  word-break: break-all;
  color: #a3a3a3;
  font-weight: 400;
}

.info-hint {
  font-size: 12px;
  color: #a3a3a3;
  margin-top: 8rpx;
  display: block;
  font-weight: 400;
}
