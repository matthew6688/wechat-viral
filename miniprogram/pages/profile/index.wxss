/* pages/profile/index.wxss - Apple 极简风格 */

.page {
  min-height: 100vh;
  background-color: var(--bg-secondary);
}

/* ========================================
   头部
   ======================================== */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) var(--spacing-lg);
  padding-top: calc(var(--spacing-2xl) + env(safe-area-inset-top));
  background-color: var(--bg-primary);
}

.avatar-section {
  margin-bottom: var(--spacing-md);
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: var(--gray-200);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background-color: var(--bg-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
}

.edit-icon {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.user-name {
  font-size: var(--font-size-title3);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.user-id {
  font-size: var(--font-size-caption);
  color: var(--text-tertiary);
}

/* ========================================
   数据统计
   ======================================== */
.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: var(--spacing-lg);
  background-color: var(--bg-primary);
  border-top: 1rpx solid var(--separator-color);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-item:active {
  opacity: 0.6;
}

.stat-value {
  font-size: var(--font-size-title2);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.stat-label {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: var(--separator-color);
}

/* ========================================
   列表区块
   ======================================== */
.section {
  margin-top: var(--spacing-xl);
}

.list-header {
  font-size: var(--font-size-footnote);
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.02em;
  padding: var(--spacing-sm) var(--spacing-lg);
}

.list-group {
  background-color: var(--bg-primary);
  border-radius: var(--radius-lg);
  margin: 0 var(--spacing-lg);
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  min-height: 88rpx;
  position: relative;
}

.list-item:active {
  background-color: var(--gray-100);
}

.list-item::after {
  content: '';
  position: absolute;
  left: 98rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background-color: var(--separator-color);
}

.list-item:last-child::after {
  display: none;
}

.list-item-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

/* 图标颜色 */
.list-item-icon.blue {
  background-color: rgba(0, 122, 255, 0.12);
}

.list-item-icon.orange {
  background-color: rgba(255, 149, 0, 0.12);
}

.list-item-icon.green {
  background-color: rgba(52, 199, 89, 0.12);
}

.list-item-icon.purple {
  background-color: rgba(175, 82, 222, 0.12);
}

.list-item-icon.teal {
  background-color: rgba(90, 200, 250, 0.12);
}

.list-item-icon.red {
  background-color: rgba(255, 59, 48, 0.12);
}

.list-item-content {
  flex: 1;
  min-width: 0;
}

.list-item-content.center {
  display: flex;
  justify-content: center;
}

.list-item-title {
  font-size: var(--font-size-body);
  color: var(--text-primary);
}

.list-item-title.danger {
  color: var(--red);
}

.list-item-subtitle {
  font-size: var(--font-size-footnote);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.list-item-value {
  font-size: var(--font-size-body);
  color: var(--text-secondary);
  margin-left: var(--spacing-sm);
}

.list-item-chevron {
  color: var(--gray-300);
  font-size: var(--font-size-title3);
  margin-left: var(--spacing-xs);
}

/* 退出登录 */
.logout-item {
  justify-content: center;
}

.logout-item::after {
  display: none;
}

/* ========================================
   底部安全区
   ======================================== */
.bottom-safe {
  height: calc(var(--spacing-2xl) + env(safe-area-inset-bottom));
}
