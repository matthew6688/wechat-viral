<!--pages/profile/index.wxml - Apple 极简风格-->
<view class="page">
  <!-- 用户信息头部 -->
  <view class="header">
    <view class="avatar-section">
      <view class="avatar-wrap" bindtap="authorizeProfile">
        <image 
          class="avatar" 
          src="{{user.wechat_avatar_url || user.avatar_url || '/images/default-avatar.png'}}" 
          mode="aspectFill"
        />
        <view class="avatar-edit">
          <text class="edit-icon">✎</text>
        </view>
      </view>
    </view>
    
    <view class="user-name">{{user.wechat_nickname || user.nickname || user.name || '点击授权'}}</view>
    <view class="user-id">ID: {{user.id ? user.id.substring(0, 8) + '...' : '--'}}</view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-card">
    <view class="stat-item" bindtap="goToRewards">
      <view class="stat-value">{{user.total_points || 0}}</view>
      <view class="stat-label">积分</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goToInvite">
      <view class="stat-value">{{user.referral_count || 0}}</view>
      <view class="stat-label">邀请</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goToRewards">
      <view class="stat-value">{{user.reward_count || 0}}</view>
      <view class="stat-label">奖品</view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="section">
    <view class="list-header">账户</view>
    <view class="list-group">
      <view class="list-item" bindtap="authorizeProfile">
        <view class="list-item-icon blue">👤</view>
        <view class="list-item-content">
          <view class="list-item-title">更新微信信息</view>
        </view>
        <view class="list-item-chevron">›</view>
      </view>
      <view class="list-item" bindtap="goToRewards">
        <view class="list-item-icon orange">🎁</view>
        <view class="list-item-content">
          <view class="list-item-title">我的奖品</view>
        </view>
        <view class="list-item-chevron">›</view>
      </view>
      <view class="list-item" bindtap="goToInvite">
        <view class="list-item-icon green">🔗</view>
        <view class="list-item-content">
          <view class="list-item-title">邀请记录</view>
        </view>
        <view class="list-item-chevron">›</view>
      </view>
    </view>
  </view>

  <!-- 更多 -->
  <view class="section">
    <view class="list-header">更多</view>
    <view class="list-group">
      <view class="list-item" bindtap="showAbout">
        <view class="list-item-icon purple">ℹ️</view>
        <view class="list-item-content">
          <view class="list-item-title">关于</view>
        </view>
        <view class="list-item-value">v1.0.0</view>
        <view class="list-item-chevron">›</view>
      </view>
      <view class="list-item" bindtap="contactService">
        <view class="list-item-icon teal">💬</view>
        <view class="list-item-content">
          <view class="list-item-title">联系客服</view>
        </view>
        <view class="list-item-chevron">›</view>
      </view>
    </view>
  </view>

  <!-- 管理员入口 -->
  <view class="section" wx:if="{{user.is_admin}}">
    <view class="list-header">管理</view>
    <view class="list-group">
      <view class="list-item" bindtap="goToAdmin">
        <view class="list-item-icon red">⚙️</view>
        <view class="list-item-content">
          <view class="list-item-title">管理后台</view>
        </view>
        <view class="list-item-chevron">›</view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="section">
    <view class="list-group">
      <view class="list-item logout-item" bindtap="handleLogout">
        <view class="list-item-content center">
          <view class="list-item-title danger">退出登录</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="bottom-safe"></view>
</view>
