<view class="profile-container">
  <!-- User Header -->
  <view class="user-header">
    <view class="avatar-container" bindtap="updateProfile">
      <image wx:if="{{user && user.wechat_avatar_url}}" class="avatar-image" src="{{user.wechat_avatar_url}}" mode="aspectFill" />
      <view wx:else class="avatar-badge">
        <text>{{user && user.name ? user.name.substring(0, 1) : '?'}}</text>
        <text class="avatar-edit-hint">点击授权</text>
      </view>
    </view>
    <view class="user-info">
      <text class="user-name">{{user && (user.wechat_nickname || user.name) ? (user.wechat_nickname || user.name) : 'User'}}</text>
      <text class="user-phone">{{user && user.phone ? user.phone : ''}}</text>
      <text wx:if="{{!user || !user.wechat_nickname}}" class="profile-hint" bindtap="updateProfile">点击头像授权微信信息</text>
    </view>
  </view>

  <!-- Role & Balance Cards -->
  <view class="info-cards">
    <view class="info-card light">
      <text class="card-label">ROLE</text>
      <text class="card-value">{{user && user.role ? user.role : 'Member'}}</text>
    </view>
    <view class="info-card dark">
      <text class="card-label">BALANCE</text>
      <text class="card-value">{{points || 0}} PTS</text>
    </view>
  </view>

  <!-- Account Details -->
  <view class="section">
    <text class="section-title">ACCOUNT DETAILS</text>
    <view class="details-list">
      <view class="detail-item">
        <view class="detail-icon">📱</view>
        <text class="detail-label">Phone</text>
        <text class="detail-value">{{user && user.phone ? user.phone : '-'}}</text>
      </view>
      <view class="detail-item">
        <view class="detail-icon">💬</view>
        <text class="detail-label">WeChat</text>
        <text class="detail-value">{{user && user.wechat_id ? user.wechat_id : '-'}}</text>
      </view>
      <view class="detail-item">
        <view class="detail-icon">🔗</view>
        <text class="detail-label">Code</text>
        <text class="detail-value">{{referralCode || '-'}}</text>
      </view>
      <view class="detail-item">
        <view class="detail-icon">📦</view>
        <text class="detail-label">Products</text>
        <text class="detail-value">{{user && user.main_products ? user.main_products : '-'}}</text>
      </view>
    </view>
  </view>

  <!-- Sign Out Button -->
  <view class="actions">
    <button class="btn-signout" bindtap="logout">Sign Out</button>
  </view>

  <!-- Admin Button (if admin) -->
  <button wx:if="{{user && user.is_admin}}" class="btn-admin" bindtap="goToAdmin">
    Admin Console
  </button>

  <!-- Profile Authorization Modal -->
  <view wx:if="{{showProfileModal}}" class="modal-overlay" catchtouchmove="preventTouchMove">
    <view class="modal-container">
      <view class="modal-header">
        <text class="modal-title">完善个人信息</text>
      </view>
      <view class="modal-body">
        <view class="modal-icon">👤</view>
        <text class="modal-text">授权您的微信头像和昵称</text>
        <text class="modal-hint">让好友更容易认出您</text>
      </view>
      <view class="modal-footer">
        <button class="btn-skip" bindtap="skipProfile">暂不授权</button>
        <button class="btn-authorize" bindtap="authorizeProfile">立即授权</button>
      </view>
    </view>
  </view>
</view>
