.register-container {
  padding: 48rpx 40rpx;
  padding-bottom: 120rpx;
  background-color: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
}

.register-header {
  margin-bottom: 48rpx;
}

.register-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.02em;
}

.register-subtitle {
  font-size: 28rpx;
  color: #6b7280;
  display: block;
  font-weight: 400;
}

.register-form {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.register-form-group {
  margin-bottom: 36rpx;
}

.register-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
  letter-spacing: 0.05em;
}

.required {
  color: #ef4444;
  font-weight: 600;
}

.register-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e7eb !important;
  border-radius: 12rpx !important;
  padding: 0 28rpx !important;
  font-size: 28rpx !important;
  background-color: #ffffff !important;
  color: #1a1a2e !important;
  box-sizing: border-box;
  line-height: 88rpx;
}

.register-placeholder {
  color: #9ca3af;
  font-size: 28rpx;
}

.register-textarea {
  width: 100%;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  color: #1a1a2e;
  box-sizing: border-box;
  min-height: 120rpx;
}

.role-selector {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.role-btn {
  padding: 24rpx 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1a1a2e;
  background-color: #ffffff;
  font-weight: 500;
  transition: all 0.2s;
}

.role-btn.active {
  background-color: #1a1a2e;
  color: #ffffff;
  border-color: #1a1a2e;
}

.register-btn-submit {
  width: 100%;
  background-color: #1a1a2e;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 32rpx;
  border: none;
}

.register-btn-submit::after {
  border: none;
}

/* Authorization Modal */
.auth-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.auth-modal {
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.auth-modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #e5e7eb;
}

.auth-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.auth-modal-body {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.auth-modal-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.auth-modal-text {
  font-size: 32rpx;
  color: #1a1a2e;
  margin-bottom: 12rpx;
  text-align: center;
}

.auth-modal-hint {
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
}

.auth-modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 24rpx;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  background-color: #f3f4f6;
  color: #6b7280;
  border-radius: 44rpx;
  border: none;
}

.btn-cancel::after {
  border: none;
}

.btn-auth-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 44rpx;
  border: none;
}

.btn-auth-submit::after {
  border: none;
}
