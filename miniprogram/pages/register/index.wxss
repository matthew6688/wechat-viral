.register-container {
  padding: 48rpx 40rpx;
  padding-bottom: 120rpx;
  background-color: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
}

.register-header {
  margin-bottom: 48rpx;
}

.register-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.02em;
}

.register-subtitle {
  font-size: 28rpx;
  color: #6b7280;
  display: block;
  font-weight: 400;
}

.register-form {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.register-form-group {
  margin-bottom: 36rpx;
}

.register-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
  letter-spacing: 0.05em;
}

.required {
  color: #ef4444;
  font-weight: 600;
}

.register-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e7eb !important;
  border-radius: 12rpx !important;
  padding: 0 28rpx !important;
  font-size: 28rpx !important;
  background-color: #ffffff !important;
  color: #1a1a2e !important;
  box-sizing: border-box;
  line-height: 88rpx;
}

.register-placeholder {
  color: #9ca3af;
  font-size: 28rpx;
}

.register-textarea {
  width: 100%;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  color: #1a1a2e;
  box-sizing: border-box;
  min-height: 120rpx;
}

.role-selector {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.role-btn {
  padding: 24rpx 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1a1a2e;
  background-color: #ffffff;
  font-weight: 500;
  transition: all 0.2s;
}

.role-btn.active {
  background-color: #1a1a2e;
  color: #ffffff;
  border-color: #1a1a2e;
}

.register-btn-submit {
  width: 100%;
  background-color: #1a1a2e;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 32rpx;
  border: none;
}

.register-btn-submit::after {
  border: none;
}
