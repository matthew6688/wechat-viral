.container {
  padding: 48rpx 40rpx;
  background-color: #ffffff;
  min-height: 100vh;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.02em;
}

.subtitle {
  font-size: 28rpx;
  color: #6b7280;
  display: block;
  font-weight: 400;
}

.form {
  display: flex;
  flex-direction: column;
}

.form-group {
  margin-bottom: 36rpx;
}

.label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
  letter-spacing: 0.05em;
}

.required {
  color: #ef4444;
  font-weight: 600;
}

.input {
  width: 100%;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  color: #1a1a2e;
  box-sizing: border-box;
}

.input:focus {
  border-color: #1a1a2e;
}

.input::placeholder {
  color: #9ca3af;
}

.textarea {
  width: 100%;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  color: #1a1a2e;
  box-sizing: border-box;
  min-height: 120rpx;
}

.role-selector {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.role-btn {
  padding: 24rpx 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1a1a2e;
  background-color: #ffffff;
  font-weight: 500;
  transition: all 0.2s;
}

.role-btn.active {
  background-color: #1a1a2e;
  color: #ffffff;
  border-color: #1a1a2e;
}

.btn-submit {
  width: 100%;
  background-color: #1a1a2e;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 32rpx;
  border: none;
}

.btn-submit::after {
  border: none;
}
