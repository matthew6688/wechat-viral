<view class="container">
  <view class="header">
    <text class="title">Create Profile</text>
    <text class="subtitle">Join to access resources and rewards.</text>
  </view>

  <view class="form">
    <!-- Full Name -->
    <view class="form-group">
      <text class="label">FULL NAME <text class="required">*</text></text>
      <input 
        class="input" 
        data-field="name" 
        value="{{formData.name}}" 
        bindinput="handleInput" 
        placeholder="" 
      />
    </view>

    <!-- Company Name -->
    <view class="form-group">
      <text class="label">COMPANY NAME</text>
      <input 
        class="input" 
        data-field="company" 
        value="{{formData.company}}" 
        bindinput="handleInput" 
        placeholder="" 
      />
    </view>

    <!-- Role Selector -->
    <view class="form-group">
      <text class="label">ROLE <text class="required">*</text></text>
      <view class="role-selector">
        <view 
          class="role-btn {{formData.role === 'Owner' ? 'active' : ''}}" 
          data-role="Owner" 
          bindtap="selectRole"
        >
          Owner
        </view>
        <view 
          class="role-btn {{formData.role === 'Sales Manager' ? 'active' : ''}}" 
          data-role="Sales Manager" 
          bindtap="selectRole"
        >
          Sales Manager
        </view>
        <view 
          class="role-btn {{formData.role === 'Sales Rep' ? 'active' : ''}}" 
          data-role="Sales Rep" 
          bindtap="selectRole"
        >
          Sales Rep
        </view>
        <view 
          class="role-btn {{formData.role === 'Other' ? 'active' : ''}}" 
          data-role="Other" 
          bindtap="selectRole"
        >
          Other
        </view>
      </view>
    </view>

    <!-- Mobile Number -->
    <view class="form-group">
      <text class="label">MOBILE NUMBER <text class="required">*</text></text>
      <input 
        class="input" 
        data-field="phone" 
        type="number" 
        value="{{formData.phone}}" 
        bindinput="handleInput" 
        placeholder="" 
      />
    </view>

    <!-- WeChat ID -->
    <view class="form-group">
      <text class="label">WECHAT ID</text>
      <input 
        class="input" 
        data-field="wechatId" 
        value="{{formData.wechatId}}" 
        bindinput="handleInput" 
        placeholder="" 
      />
    </view>

    <!-- Main Products -->
    <view class="form-group">
      <text class="label">MAIN PRODUCTS</text>
      <textarea 
        class="textarea" 
        data-field="mainProducts" 
        value="{{formData.mainProducts}}" 
        bindinput="handleInput" 
        placeholder="" 
      />
    </view>

    <!-- Submit Button -->
    <button class="btn-submit" bindtap="onRegister">Complete Registration</button>
  </view>
</view>
