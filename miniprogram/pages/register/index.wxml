<view class="register-container">
  <view class="register-header">
    <text class="register-title">Create Profile</text>
    <text class="register-subtitle">Join to access resources and rewards.</text>
  </view>

  <form class="register-form" catchsubmit="onRegister">
    <!-- Full Name -->
    <view class="register-form-group">
      <text class="register-label">FULL NAME <text class="required">*</text></text>
      <input 
        class="register-input" 
        name="name"
        data-field="name" 
        value="{{formData.name}}" 
        bindinput="handleInput"
        placeholder="请输入姓名"
        placeholder-class="register-placeholder"
        cursor-spacing="20"
      />
    </view>

    <!-- Company Name -->
    <view class="register-form-group">
      <text class="register-label">COMPANY NAME</text>
      <input 
        class="register-input" 
        name="company"
        data-field="company" 
        value="{{formData.company}}" 
        bindinput="handleInput"
        placeholder="请输入公司名称"
        placeholder-class="register-placeholder"
        cursor-spacing="20"
      />
    </view>

    <!-- Role Selector -->
    <view class="register-form-group">
      <text class="register-label">ROLE <text class="required">*</text></text>
      <view class="role-selector">
        <view 
          class="role-btn {{formData.role === 'Owner' ? 'active' : ''}}" 
          data-role="Owner" 
          bindtap="selectRole"
        >
          Owner
        </view>
        <view 
          class="role-btn {{formData.role === 'Sales Manager' ? 'active' : ''}}" 
          data-role="Sales Manager" 
          bindtap="selectRole"
        >
          Sales Manager
        </view>
        <view 
          class="role-btn {{formData.role === 'Sales Rep' ? 'active' : ''}}" 
          data-role="Sales Rep" 
          bindtap="selectRole"
        >
          Sales Rep
        </view>
        <view 
          class="role-btn {{formData.role === 'Other' ? 'active' : ''}}" 
          data-role="Other" 
          bindtap="selectRole"
        >
          Other
        </view>
      </view>
    </view>

    <!-- Mobile Number -->
    <view class="register-form-group">
      <text class="register-label">MOBILE NUMBER <text class="required">*</text></text>
      <input 
        class="register-input" 
        name="phone"
        data-field="phone" 
        type="number" 
        value="{{formData.phone}}" 
        bindinput="handleInput"
        placeholder="请输入手机号"
        placeholder-class="register-placeholder"
        cursor-spacing="20"
      />
    </view>

    <!-- WeChat ID -->
    <view class="register-form-group">
      <text class="register-label">WECHAT ID</text>
      <input 
        class="register-input" 
        name="wechatId"
        data-field="wechatId" 
        value="{{formData.wechatId}}" 
        bindinput="handleInput"
        placeholder="请输入微信号"
        placeholder-class="register-placeholder"
        cursor-spacing="20"
      />
    </view>

    <!-- Main Products -->
    <view class="register-form-group">
      <text class="register-label">MAIN PRODUCTS</text>
      <textarea 
        class="register-textarea" 
        name="mainProducts"
        data-field="mainProducts" 
        value="{{formData.mainProducts}}" 
        bindinput="handleInput"
        placeholder="请输入主营产品"
        placeholder-class="register-placeholder"
        cursor-spacing="20"
        auto-height="{{true}}"
      />
    </view>

    <!-- Submit Button -->
    <button class="register-btn-submit" form-type="submit">Complete Registration</button>
  </form>

  <!-- Authorization Modal -->
  <view wx:if="{{showAuthModal}}" class="auth-modal-overlay" catchtouchmove="preventTouchMove">
    <view class="auth-modal">
      <view class="auth-modal-header">
        <text class="auth-modal-title">完善注册信息</text>
      </view>
      <view class="auth-modal-body">
        <view class="auth-modal-icon">👤</view>
        <text class="auth-modal-text">授权微信头像和昵称</text>
        <text class="auth-modal-hint">让好友更容易认出您</text>
      </view>
      <view class="auth-modal-footer">
        <button class="btn-cancel" bindtap="cancelAuth">取消</button>
        <button class="btn-auth-submit" bindtap="authorizeAndSubmit">授权并提交</button>
      </view>
    </view>
  </view>
</view>
